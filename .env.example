# ─────────────────────────────────────────
# CONFIGURAÇÕES DE AMBIENTE (.env)
# ─────────────────────────────────────────
# Este é um arquivo de exemplo. Crie um arquivo chamado `.env` na raiz do projeto
# e preencha as variáveis abaixo com as chaves reais.
# NOTA: O arquivo `.env` não é comitado, ele já está no .gitignore.

# ── CRIPTOGRAFIA ──────────────────────────
# Chave de 32 bytes (64 caracteres hexadecimais) usada para criptografar
# e descriptografar chaves de API de Inteligência Artificial no banco.
# Exemplo gerável com Node: crypto.randomBytes(32).toString('hex')
ENCRYPTION_KEY=

# ── SUPABASE (Frontend & Backend) ─────────
# Chaves públicas do projeto no Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# ── BANCO DE DADOS (Prisma) ───────────────
# Usado pela aplicação em tempo de execução. Geralmente aponta para o Pooler do Supabase (porta 6543)
# com pgbouncer=true no final para modo de transação.
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Usado APENAS pelo Prisma CLI para rodar migrações (npx prisma migrate).
# Deve apontar para a conexão direta Session Mode do Supabase (porta 5432).
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── SERVIDOR ──────────────────────────────
PORT=3000
ALLOWED_ORIGINS=*


# ─────────────────────────────────────────
# CONFIGURAÇÕES DE TESTES (.env.test.local)
# ─────────────────────────────────────────
# Se você for rodar testes de integração (npx jest), crie também o arquivo
# `.env.test.local` na raiz e adicione apenas a chave abaixo.
# Os testes vão ler o resto das variáveis do arquivo `.env` principal.

# Chave secreta de administração (NUNCA expor no front ou no .env de dev/prod).
# Necessária nos testes para que a suíte possa criar/limpar usuários falsos.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbG... 